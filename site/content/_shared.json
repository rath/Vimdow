  "demo": {
    "stage": {
      "width": 640,
      "height": 400
    },
    "windows": {
      "a": {
        "x": 56,
        "y": 60,
        "w": 240,
        "h": 160
      },
      "b": {
        "x": 360,
        "y": 124,
        "w": 224,
        "h": 196
      }
    },
    "steps": [
      {
        "id": "enter",
        "keys": [
          {
            "key": "⌃⌥A",
            "mode": "command"
          }
        ]
      },
      {
        "id": "right",
        "keys": [
          {
            "key": "l",
            "frame": {
              "x": 76
            }
          },
          {
            "key": "l",
            "frame": {
              "x": 96
            }
          },
          {
            "key": "l",
            "frame": {
              "x": 116
            }
          }
        ]
      },
      {
        "id": "down",
        "keys": [
          {
            "key": "1"
          },
          {
            "key": "2"
          },
          {
            "key": "j",
            "frame": {
              "y": 156
            }
          }
        ]
      },
      {
        "id": "grow",
        "keys": [
          {
            "key": "⌥l",
            "frame": {
              "w": 260
            }
          },
          {
            "key": "⌥l",
            "frame": {
              "w": 280
            }
          },
          {
            "key": "⌥l",
            "frame": {
              "w": 300
            }
          }
        ]
      },
      {
        "id": "center",
        "keys": [
          {
            "key": "z"
          },
          {
            "key": "z",
            "frame": {
              "x": 170,
              "y": 132
            }
          }
        ]
      },
      {
        "id": "undo",
        "keys": [
          {
            "key": "u",
            "frame": {
              "x": 116,
              "y": 156
            }
          }
        ]
      },
      {
        "id": "half",
        "keys": [
          {
            "key": "⌃W"
          },
          {
            "key": "H",
            "frame": {
              "x": 0,
              "y": 24,
              "w": 320,
              "h": 376
            }
          }
        ]
      },
      {
        "id": "switch",
        "keys": [
          {
            "key": "Q",
            "guides": true,
            "hold": 1000
          },
          {
            "key": "2",
            "guides": false,
            "focus": "b",
            "mode": "normal"
          }
        ]
      },
      {
        "id": "tile",
        "keys": [
          {
            "key": "⌃⌥A",
            "mode": "command"
          },
          {
            "key": "⌃W"
          },
          {
            "key": "L",
            "frame": {
              "x": 320,
              "y": 24,
              "w": 320,
              "h": 376
            }
          }
        ]
      },
      {
        "id": "exit",
        "keys": [
          {
            "key": "esc",
            "mode": "normal"
          }
        ]
      }
    ]
  },
